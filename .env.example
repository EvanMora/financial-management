# Copia este archivo como .env y pon tus valores. El .env no se sube al repo.

# Clave de la API de Gemini: https://aistudio.google.com/apikey
# Sin ella la app funciona igual, pero sin IA: no aparecen el asistente de Movimientos ni el análisis del Resumen.
GEMINI_API_KEY=

# Opcional: modelo a usar. Por defecto, gemini-flash-lite-latest.
# GEMINI_MODEL=gemini-flash-lite-latest
